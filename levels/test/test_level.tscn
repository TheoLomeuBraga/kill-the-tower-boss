[sub_resource type="Shader" id="Shader_eyywi"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.7.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_nearest, repeat_enable;
uniform ivec2 albedo_texture_size;
uniform float point_size : hint_range(0.1, 128.0, 0.1);

uniform sampler2D power_gradient : source_color, filter_nearest, repeat_disable;
uniform sampler2D wind_noise : source_color, filter_nearest, repeat_enable;

void vertex() {
	float power = texture(power_gradient, UV).r;
	float noise = texture(wind_noise, UV + vec2(TIME/4.0)).r;
	noise -= 0.25;
	vec3 displacement = NORMAL * (power * noise);
	VERTEX += displacement;
}

void fragment() {

	vec4 albedo_tex = texture(texture_albedo, UV);
	ALBEDO = albedo.rgb * albedo_tex.rgb;

	METALLIC = 0.0;
	SPECULAR = 0.0;
	ROUGHNESS = 1.0;
}
"

